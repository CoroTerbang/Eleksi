<%- include('../partials/header', { title, admin: false }) %>
<section class="card card-narrow vote-success">
  <div class="success-mark" aria-hidden="true">✓</div>
  <h1>Terima Kasih</h1>
  <p class="muted"><%= electionTitle || 'Pemilihan' %> — <%= voter.name %> telah menggunakan hak pilih.</p>
  <% if (chosen && chosen.length) { %>
    <p>Pilihan: <strong><%= chosen.join(', ') %></strong></p>
  <% } %>
  <p class="muted">Kembali ke layar kode dalam <span id="countdown">5</span> detik.</p>
  <a href="/vote" class="btn btn-primary">Pemilih Berikutnya</a>
</section>
<script>
  (function () {
    var left = 5;
    var el = document.getElementById('countdown');
    setInterval(function () {
      left -= 1;
      if (left <= 0) { window.location.href = '/vote'; }
      else if (el) el.textContent = String(left);
    }, 1000);
  })();
</script>
<%- include('../partials/footer') %>
